<?xml version="1.0" encoding="utf-8"?>

<!--
  Adaptive launcher icon — background layer.

  Deep navy rather than the previous flat #000000. The mark is a violet-to-cyan
  arch, and #000 sits too far outside that gradient for the icon to read as one
  object: on an AMOLED launcher the plate disappears and the arch floats with
  nothing behind it. A navy close to the gradient's endpoints gives the mark a
  ground without adding a visible square.

  The gradient is vertical and deliberately shallow — 108dp of icon is 48dp on
  a home screen, and a strong gradient at that size reads as noise.
-->

<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#FF121C38" />
                <item android:offset="1" android:color="#FF070A18" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
